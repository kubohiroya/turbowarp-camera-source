{
  "name": "@kubohiroya/turbowarp-camera-source",
  "version": "0.21.0",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "description": "A TurboWarp capability extension for sharing one MediaDevices camera stream across extensions.",
  "type": "module",
  "license": "MPL-2.0",
  "homepage": "https://kubohiroya.github.io/turbowarp-camera-source/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-camera-source.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-camera-source/issues"
  },
  "exports": {
    "./camera-source.js": "./dist/camera-source.js",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    },
    "./package.json": "./package.json",
    "./editor-schema": {
      "types": "./lib-editor/src/editor-schema.d.ts",
      "import": "./lib-editor/src/editor-schema.js"
    },
    "./editor-metadata": {
      "types": "./lib-editor/src/editor-metadata.d.ts",
      "import": "./lib-editor/src/editor-metadata.js"
    }
  },
  "files": [
    "assets/",
    "dist/",
    "schemas/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "lib-editor/"
  ],
  "unpkg": "./dist/camera-source.js",
  "jsdelivr": "./dist/camera-source.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.lib.json && npm run build:editor",
    "lint": "eslint src tests vite.config.ts",
    "format": "eslint src tests vite.config.ts --fix",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts && node scripts/generate-fixed-input-docs.mjs",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md README.ja.md",
    "docs:pages:check": "node scripts/check-pages.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "pnpm publish --dry-run --access public --no-git-checks",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run docs:pages:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "prepack": "node scripts/prepack.mjs",
    "build:editor": "tsc -p tsconfig.editor.json",
    "prepare": "npm run build",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@kubohiroya/turbowarp-app-shell": "^0.5.0",
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.4.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.9.0",
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "react-dom": "18.3.1",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.4.0"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "camera",
    "media-devices",
    "getusermedia"
  ]
}
